library(cluster)
#requerido escalar debido que trabajamos con distancia
D <- scale(iris[,-5]) #dataset base
km.iris <- kmeans (D, centers= 3, nstart = 20) # encontrar un optimo local, nstart entre 10 y 20 es suficiete. cuantos clsuters reamos centers aqui tres
set.seed(77)
print(km.iris)
#centroides (clusters): si tomas del grupo uno
#vector de etiquetas , te muestra a que cluster se mandaron las obs. al cluster 3, otros al dos otros al uno.
D = as.data.frame(D)
plot(D$Petal.Length,D$Petal.Width,
col= iris$Species, pch = as.numeric(km.iris$cluster)+14)# toma forma predeterminadas de puntos
#dispersion de variables
#se puede hacer pairs para ver todas las graficas
km.iris2 <- kmeans(D, centers =2, nstar=20)
D = as.data.frame(D)
plot(D$Petal.Length,D$Petal.Width,
col= iris$Species, pch = as.numeric(km.iris2$cluster)+14)
km.iris3 <- kmeans(D, centers =4, nstar=20)
D = as.data.frame(D)
plot(D$Petal.Length,D$Petal.Width,
col= iris$Species, pch = as.numeric(km.iris3$cluster)+14)
k <- seq(2,10, 1)
nk <- length(k)
w <- rep(0, nk)
S <- rep(0, nk)
dist.mat <- dist(D, method = "euclidean")
for (i in 1:nk)
{
km.iris <- kmeans(D, centers = k[i], nstart = 20)
w[i] = km.iris$tot.withinss
sil_obj <- silhouette(km.iris$cluster, dist.mat)
sum.sil <- summary(sil_obj)
S[i] <- sum.sil$avg.width
}
par(mfrow = c(1,2))
plot(k, w, type = "b", col = "cyan", )
plot(k, S, type = "b", col = "red", )
View(D)
